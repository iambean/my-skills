{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$",
            "description": "Top-level folder name. Always YYYY-MM-DD-slug, never nested."
          },
          "title": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+/$",
            "description": "Catalog heading. Must be the dated slug plus a trailing slash."
          },
          "description": { "type": "string" },
          "updated": { "type": "string" }
        }
      }
    }
  }
}
